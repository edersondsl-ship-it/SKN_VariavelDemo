# IP e rack/slot da CPU1200
PLC_IP=192.168.1.10
PLC_RACK=0
PLC_SLOT=1

# ID do dosador no servidor (ver tabela dosadores no banco)
DOSADOR_ID=1

# URL do servidor em nuvem
SERVER_URL=http://localhost:3001

# Token de autenticação (deve ser igual ao AGENT_TOKEN no servidor)
AGENT_TOKEN=token-secreto-do-agente

# Intervalo de leitura em milissegundos (padrão: 5 segundos)
INTERVALO_MS=5000
