# IP da CPU1200 na rede local
PLC_IP=10.21.0.1

# Rack e Slot da CPU (1200 é sempre rack 0, slot 1)
PLC_RACK=0
PLC_SLOT=1

# ID do dosador no servidor (ver tabela dosadores no banco)
DOSADOR_ID=1

# URL do servidor em nuvem
SERVER_URL=https://sinkron.up.railway.app

# Token de autenticação (deve ser igual ao AGENT_TOKEN no servidor)
AGENT_TOKEN=token-secreto-do-agente

# Intervalo de leitura em milissegundos
INTERVALO_MS=10000
